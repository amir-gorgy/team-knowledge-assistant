DATABASE_URL=postgresql://app:app@localhost:5432/tka

# OpenAI-compatible embeddings endpoint (LM Studio by default)
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_API_KEY=lm-studio
EMBEDDING_DIM=768

# Cross-encoder for search_docs and --rerank (fastembed; downloaded on first use).
# Its score scale is its own: re-measure the not-found threshold when you change it.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_NOT_FOUND_BELOW=-1.5

# Who writes `ask` answers: "local" = the chat model below; "copilot" = no chat model, `ask` returns
# the numbered sources and Copilot (through MCP) or the CLI/API caller writes the answer.
ANSWER_BACKEND=local

# OpenAI-compatible chat endpoint that writes the cited answers when ANSWER_BACKEND=local.
# Load it with a context length of 8192 or more: lms load qwen/qwen3.5-9b --context-length 8192
CHAT_BASE_URL=http://localhost:1234/v1
CHAT_MODEL=qwen/qwen3.5-9b
CHAT_API_KEY=lm-studio
# "none" = no thinking (fast). "low"/"medium"/"high" let the model think first (slow; raise
# CHAT_MAX_TOKENS too, since thinking counts against it).
CHAT_REASONING_EFFORT=none
CHAT_MAX_TOKENS=1024
